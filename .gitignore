# Local, private banned-token overrides for the sanitization gate (never committed)
scripts/screenshots/.banned-tokens.json

# Release gate record (per-machine, references a local SHA)
.release-gate.json

# Review ledgers are TRACKED, one per set of acceptance criteria, which is why
# the pattern is a wildcard. Each holds hashes, counts, model names and finding
# fingerprints and no prose, so they are safe here and can be read later to
# answer how many rounds a change needed and whether a verdict was overridden.
# Each row carries the hash of the criteria it was judged against, so a verdict
# stays verifiable even though those criteria are not in this repository.
#
# The round directories are NOT tracked: they hold written findings.
.independent-review/*
!.independent-review/*.jsonl
