#!/usr/bin/env node
'use strict';
// Stub `codex` binary for the Rundock test suite: a long-lived JSONL
// JSON-RPC 2.0 app-server on stdio (`codex app-server`), matching the real
// CLI surface Rundock uses. The exec mode of earlier releases is gone with
// the exec runtime itself.
//
// Injection: the test harness prepends this directory to PATH (or passes the
// path directly via binPath), so the codex binary resolution finds this stub
// with zero production changes. No network.
//
// Scripting: reads `stub-codex-scenario.json` from cwd; app-server behaviour
// lives under "appServer":
//   { "appServer": {
//       "version": "0.144.3",             // embedded in the initialize userAgent
//       "dropMethods": ["thread/resume"], // requests logged but never answered
//       "initializeUntilFile": "...",     // answer initialize only once this file
//                                         // exists, holding the server in its start
//       "ignoreSigterm": true,            // log a SIGTERM and carry on, so only a
//                                         // SIGKILL ends the process (read at spawn)
//       "outliveStdin": true,             // keep running once stdin closes, so the
//                                         // process outlives the Rundock that
//                                         // started it unless a signal ends it
//       "overload": {"method": "thread/start", "times": 2},  // first N get -32001
//       "resumeFails": true,              // thread/resume -> -32600 "no rollout found"
//       "resumeUntilFile": "...",         // answer thread/resume, however it will be
//                                         // answered, only once this file exists
//       "resumeTransientFails": 2,        // first N thread/resume PER THREAD fail with
//                                         // (combine with resumeFails to get N transient
//                                         // failures and then a permanent one, which is
//                                         // the runtime's transient-turned-permanent path)
//                                         // the live "rollout at ... is empty" wording
//                                         // (Windows Finding 6 Mode 1), then succeed
//       "dropInterrupt": true,            // turn/interrupt ends the turn server-side but
//                                         // neither the response nor turn/completed is
//                                         // sent (lost-stream shape, Finding 6 Mode 2)
//       "zombieInterrupt": {"resumeDelayMs": 400},
//                                         // turn/interrupt is ACCEPTED (empty response)
//                                         // but NO turn/completed follows and the turn
//                                         // keeps running in the background: after
//                                         // resumeDelayMs it emits its remaining deltas,
//                                         // item/completed agentMessage (full text),
//                                         // tokenUsage and turn/completed, potentially
//                                         // AFTER a new turn has started on the same
//                                         // thread (Windows Finding 7, codex-cli
//                                         // 0.144.4 on Windows ARM). The server-side
//                                         // slot frees, so a follow-up turn/start
//                                         // succeeds, exactly as observed live.
//       "observePaths": ["/abs/path"],    // log each path's state with every
//                                         // request as it arrives: null when
//                                         // missing, "dir", or a file's text
//       "rules": [ {
//         "match": {"promptIncludes": "..."},
//         "deltas": ["chunk1 ", "chunk2"],  // item/agentMessage/delta sequence
//         "text": "full final text",         // item/completed agentMessage
//         "usage": {"inputTokens":100, "cachedInputTokens":0, "outputTokens":50},
//         "approval": {"kind":"command"|"fileChange", "command":"...",
//                      "reason":"...", "grantRoot":null,
//                      "afterDecision": {"accept":{"text":"..."}, "decline":{"text":"..."}}},
//         "error": {"codexErrorInfo":"usageLimitExceeded", "message":"...", "willRetry":false},
//                                            // "thenContinue": true sends the error and
//                                            // carries on with the rest of the rule
//                                            // instead of failing the turn, so a test
//                                            // decides how a turn with an error ends
//         "delayMs": 0,                     // pause before the agent output
//         "untilFile": "...",                // hold the turn before its output until
//                                            // this file exists, so a test decides
//                                            // when it ends
//         "holdForInterrupt": true,          // after the first delta, stay running
//                                            // until turn/interrupt arrives, so a test
//                                            // cannot lose the race to a turn that is
//                                            // only alive for a few milliseconds
//         "noise": true,                     // malformed line + unknown notification + ghost delta
//         "crashMidTurn": true,              // exit(1) after the deltas
//         "hangAfterDeltas": true,           // never complete (interrupt tests)
//         "compaction": {                    // the thread summarised to make room
//           "afterDeltas": 0,                // 0: before the reply; N: the reply's
//                                            // first item closes after N deltas and
//                                            // a second item carries the rest
//           "count": 1,                      // summaries in this turn
//           "item": true,                    // contextCompaction item/started (+completed)
//           "finish": true,                  // false: started, never completed
//           "duplicate": false,              // the item/completed sent twice
//           "notice": false,                 // the older thread/compacted notice too;
//                                            // a number sends it that many times,
//                                            // as a replay would
//           "malformed": false }             // shapes missing their fields, instead
//         "helpers": [ {                     // helper threads this turn starts, one
//                                            // after another, after the user message:
//                                            // each sends thread/started and a
//                                            // subAgentActivity item on the lead's
//                                            // thread, then runs its own turn
//           "nickname": "rates", "role": "worker",  // null nickname: none is sent
//           "agentPath": "root/rates",       // default root/<nickname>
//           "source": "thread_spawn",        // or review, compact,
//                                            // memory_consolidation, other
//           "nicknameIn": "both",            // source, thread or both
//           "threadStartedFirst": false,     // thread/started before the activity
//           "noThreadStarted": false,        // the activity item alone
//           "kind": "started",               // the activity item's kind
//           "items": [{"type":"commandExecution","command":"ls"},
//                     {"type":"fileChange","paths":["a.md"]},
//                     {"type":"mcpToolCall","server":"s","tool":"t"},
//                     {"type":"webSearch","query":"q"}],
//           "approval": {...},               // as the rule's, on the helper's turn
//           "text": "...", "usage": {...}, "status": "completed",  // or failed
//           "delayMs": 0, "untilFile": "...", "holdForInterrupt": true,
//           "interruptFails": true,          // turn/interrupt answered with an
//                                            // error; the turn carries on
//           "dropInterrupt": true,           // turn/interrupt never answered; the
//                                            // turn carries on
//           "depth2": {"approval": {...}},   // the helper starts a helper of its own
//           "again": {"untilFile": "...", "noActivity": false, ...}
//                                            // once ended, given more work: an
//                                            // interacted activity on the lead's
//                                            // thread, then a new turn on this one
//         } ],
//         "awaitHelpers": true,              // the lead's reply waits for every
//                                            // helper turn to end
//   } ] } }
// First matching rule wins. Every invocation and every incoming app-server
// request is appended to `stub-invocations.jsonl` (cwd) for spawn-argument,
// prompt-content, and policy-invariant assertions.
//
// Event shapes come from the shared fixture file (test/fixtures/
// codex-appserver-protocol.js): the SAME fixtures the client unit tests pin,
// so stub and client can never drift apart. Everything the stub sends omits
// the `jsonrpc` field, exactly like the real server
// (docs/protocol/codex-app-server/RESEARCH.md section 1).

const fs = require('fs');
const path = require('path');

const argv = process.argv.slice(2);

// Version probe: answer immediately without touching stdin or the scenario,
// so runtime detection never hangs on the stub.
if (argv.includes('--version')) {
  process.stdout.write('codex-cli 0.0.0-stub\n');
  process.exit(0);
}

const SCENARIO_FILE = path.join(process.cwd(), 'stub-codex-scenario.json');
const LOG_FILE = path.join(process.cwd(), 'stub-invocations.jsonl');

process.stdout.on('error', () => {});
function writeOut(s) {
  try { process.stdout.write(s); } catch (e) { /* killed mid-write */ }
}

function matches(rule, prompt) {
  const m = rule.match || {};
  const includes = m.promptIncludes == null ? [] : [].concat(m.promptIncludes);
  for (const s of includes) if (!prompt.includes(s)) return false;
  return true;
}

// One path as it stands now: null when missing, 'dir', or a file's text.
function pathState(p) {
  try {
    return fs.statSync(p).isDirectory() ? 'dir' : fs.readFileSync(p, 'utf-8');
  } catch (e) {
    return null;
  }
}

if (argv[0] === 'app-server') {
  runAppServer();
} else {
  // The exec runtime is retired: nothing should invoke this stub any other
  // way. Fail loudly so a regression is visible in the failing test.
  process.stderr.write(`stub codex: unsupported invocation: ${argv.join(' ')}\n`);
  process.exit(2);
}

// ── App-server mode ─────────────────────────────────────────────────────────

function runAppServer() {
  const asfx = require(path.join(__dirname, '..', '..', 'fixtures', 'codex-appserver-protocol.js'));
  const crypto = require('crypto');

  // Scenario is re-read per message so tests can rewrite it between turns.
  function loadConfig() {
    try {
      return JSON.parse(fs.readFileSync(SCENARIO_FILE, 'utf-8')).appServer || {};
    } catch (e) {
      return {};
    }
  }

  function log(entry) {
    try {
      fs.appendFileSync(LOG_FILE, JSON.stringify({
        bin: 'codex', mode: 'app-server', pid: process.pid, ts: Date.now(), ...entry,
      }) + '\n');
    } catch (e) { /* logging is best-effort */ }
  }
  log({ event: 'spawn', argv });
  if (loadConfig().ignoreSigterm) process.on('SIGTERM', () => log({ event: 'sigterm-ignored' }));

  function send(obj) { writeOut(JSON.stringify(obj) + '\n'); }

  let initializedDone = false;
  let serverReqId = 1000;                    // server-to-client request ids (approvals)
  const pendingServerRequests = new Map();   // id -> resolve(decision)
  const activeTurns = new Map();             // threadId -> { turnId, threadId, finished }
  const overloadCounts = new Map();          // method -> requests already rejected
  const resumeFailCounts = new Map();        // threadId -> transient resume failures served

  const tick = (ms = 2) => new Promise(r => setTimeout(r, ms));

  function finishTurn(t, status, error) {
    if (t.finished) return;
    t.finished = true;
    // Guarded delete: a zombie turn (zombieInterrupt) was already evicted
    // from the map at interrupt time, and the slot may now belong to a NEW
    // turn on the same thread; never delete that one.
    if (activeTurns.get(t.threadId) === t) activeTurns.delete(t.threadId);
    send(asfx.threadStatusChanged(t.threadId, 'idle'));
    send(asfx.turnCompleted(t.threadId, t.turnId, status, error || null));
  }

  // One approval on a helper's turn (or a helper's own helper), answered by
  // the client: returns 'accept', 'decline' or 'cancel', and waits for a
  // steered line after the decision when the spec asks, as runTurn does.
  async function askApproval(t, a) {
    const itemId = `item_appr_${t.turnId.slice(0, 8)}`;
    const reqId = ++serverReqId;
    const base = { threadId: t.threadId, turnId: t.turnId, itemId, reason: a.reason || null };
    send(a.kind === 'fileChange' ? asfx.itemStartedFileChange(t.threadId, t.turnId, itemId)
      : asfx.itemStartedCommandExecution(t.threadId, t.turnId, itemId, a.command || 'true'));
    const decision = await new Promise(resolve => {
      pendingServerRequests.set(reqId, resolve);
      send(a.kind === 'fileChange' ? asfx.fileChangeApprovalRequest(reqId, base)
        : asfx.commandApprovalRequest(reqId, { ...base, command: a.command || 'true' }));
    });
    log({ approvalDecision: decision, requestId: reqId, threadId: t.threadId });
    const key = decision === 'decline' || decision === 'cancel' ? decision : 'accept';
    const waitMs = key === 'decline' ? a.awaitSteerMs : (key === 'accept' ? a.awaitSteerOnAcceptMs : 0);
    const until = Date.now() + (waitMs || 0);
    while (waitMs > 0 && !t.steered && !t.finished && Date.now() < until) await tick(5);
    return key;
  }

  // Start one helper from the lead's turn `lead`: its thread/started and the
  // activity item on the lead's thread in the order the spec asks, then its
  // own turn, left running.
  async function launchHelper(lead, h, i) {
    const nickname = h.nickname === undefined ? `helper${i + 1}` : h.nickname;
    const agentPath = h.agentPath || `root/${nickname || `helper${i + 1}`}`;
    const threadId = crypto.randomUUID();
    const started = () => {
      if (!h.noThreadStarted) send(asfx.subAgentThreadStarted(threadId, { nickname, role: h.role || null, source: h.source || 'thread_spawn', agentPath, parentThreadId: lead.threadId, nicknameIn: h.nicknameIn || 'both' }));
    };
    if (h.threadStartedFirst) started();
    const act = { id: `act_${lead.turnId.slice(0, 8)}_${i}`, agentPath, agentThreadId: threadId, kind: h.kind || 'started' };
    send(asfx.subAgentActivityItem(lead.threadId, lead.turnId, act, 'started'));
    send(asfx.subAgentActivityItem(lead.threadId, lead.turnId, act, 'completed'));
    await tick();
    if (!h.threadStartedFirst) started();
    const ht = { turnId: crypto.randomUUID(), threadId, finished: false, helper: h, lead, agentPath };
    activeTurns.set(threadId, ht);
    lead.helperTurns.push(ht);
    runHelperTurn(ht, h).catch(() => {});
    await tick();
  }

  async function runHelperTurn(ht, h) {
    await helperTurnBody(ht, h);
    if (!h.again) return;
    // Given more work once ended (however it ended): the lead's thread
    // records it, then the helper's thread runs a new turn.
    const a = h.again;
    const { threadId, turnId } = ht;
    if (a.delayMs > 0) await tick(a.delayMs);
    while (a.untilFile && !fs.existsSync(a.untilFile)) await tick(20);
    const lead = activeTurns.get(ht.lead.threadId) || ht.lead;
    if (!a.noActivity) {
      const act = { id: `act_${lead.turnId.slice(0, 8)}_again_${turnId.slice(0, 4)}`, agentPath: ht.agentPath, agentThreadId: threadId, kind: 'interacted' };
      send(asfx.subAgentActivityItem(lead.threadId, lead.turnId, act, 'started'));
      send(asfx.subAgentActivityItem(lead.threadId, lead.turnId, act, 'completed'));
      await tick();
    }
    const next = { turnId: crypto.randomUUID(), threadId, finished: false, helper: a, lead: ht.lead, agentPath: ht.agentPath };
    activeTurns.set(threadId, next);
    if (lead.helperTurns) lead.helperTurns.push(next);
    await runHelperTurn(next, a);
  }

  async function helperTurnBody(ht, h) {
    const { threadId, turnId } = ht;
    send(asfx.threadStatusChanged(threadId, 'active'));
    send(asfx.turnStarted(threadId, turnId));
    await tick();
    if (h.depth2) {
      // The helper starts one of its own: an activity item on ITS thread.
      const sub = { turnId: crypto.randomUUID(), threadId: crypto.randomUUID(), finished: false };
      send(asfx.subAgentActivityItem(threadId, turnId, { id: `act_${turnId.slice(0, 8)}_d2`, agentPath: `${ht.agentPath}/deeper`, agentThreadId: sub.threadId, kind: 'started' }, 'started'));
      send(asfx.subAgentThreadStarted(sub.threadId, { nickname: 'deeper', parentThreadId: threadId, depth: 2 }));
      send(asfx.turnStarted(sub.threadId, sub.turnId));
      if (h.depth2.approval) await askApproval(sub, h.depth2.approval);
      sub.finished = true;
      send(asfx.turnCompleted(sub.threadId, sub.turnId, 'completed', null));
    }
    if (h.delayMs > 0) await tick(h.delayMs);
    while (h.untilFile && !fs.existsSync(h.untilFile) && !ht.finished) await tick(20);
    for (const spec of h.items || []) {
      if (ht.finished) return;
      const id = `${spec.type}_${turnId.slice(0, 8)}_${Math.random().toString(36).slice(2, 6)}`;
      send(asfx.toolItem('started', threadId, turnId, { ...spec, id }));
      await tick();
      send(asfx.toolItem('completed', threadId, turnId, { ...spec, id }));
      await tick();
    }
    if (h.approval && !ht.finished) {
      const key = await askApproval(ht, h.approval);
      if (key === 'cancel') finishTurn(ht, 'interrupted');
    }
    if (h.holdForInterrupt) {
      const until = Date.now() + 30000;
      while (!ht.interrupted && !ht.finished && Date.now() < until) await tick(5);
    }
    if (ht.finished) return;
    const itemId = `msg_${turnId.slice(0, 8)}`;
    send(asfx.itemStartedAgentMessage(threadId, turnId, itemId));
    send(asfx.agentMessageDelta(threadId, turnId, itemId, h.text || 'HELPER-TEXT'));
    send(asfx.itemCompletedAgentMessage(threadId, turnId, itemId, h.text || 'HELPER-TEXT'));
    send(asfx.tokenUsageUpdated(threadId, turnId, h.usage || { inputTokens: 900, outputTokens: 90 }));
    finishTurn(ht, h.status || 'completed', h.status === 'failed' ? { message: 'helper failed' } : null);
  }

  // Drive one scripted turn. Realistic notification order per RESEARCH.md
  // section 4. Each step awaits a tick so concurrent turns on other threads
  // interleave on the shared stdout, exactly like the real server, and so a
  // turn/interrupt arriving mid-sequence can stop the remaining steps.
  async function runTurn(t, prompt, rule) {
    const { threadId, turnId } = t;
    const shortId = turnId.slice(0, 8);
    // zombieInterrupt: once the ignored interrupt lands, the turn pauses
    // until its scripted resume time, then carries on to completion in the
    // background (the live Windows Finding 7 shape).
    const zombieGate = async () => {
      while (t.zombieResumeAt && Date.now() < t.zombieResumeAt) await tick(10);
    };
    send(asfx.threadStatusChanged(threadId, 'active'));
    send(asfx.turnStarted(threadId, turnId));
    await tick();
    if (t.finished) return;
    const userItemId = `item_user_${shortId}`;
    send(asfx.itemStartedUserMessage(threadId, turnId, userItemId, prompt));
    send(asfx.itemCompletedUserMessage(threadId, turnId, userItemId, prompt));

    t.helperTurns = [];
    for (let i = 0; i < (rule.helpers || []).length; i++) {
      await launchHelper(t, rule.helpers[i], i);
      if (t.finished) return;
    }

    if (rule.delayMs > 0) await tick(rule.delayMs);
    while (rule.untilFile && !fs.existsSync(rule.untilFile) && !t.finished) await tick(20);
    if (t.finished) return;

    let text = rule.text || '';

    if (rule.approval) {
      const a = rule.approval;
      const approvalItemId = `item_appr_${shortId}`;
      const reqId = ++serverReqId;
      let request;
      if (a.kind === 'fileChange') {
        send(asfx.itemStartedFileChange(threadId, turnId, approvalItemId));
        request = asfx.fileChangeApprovalRequest(reqId, {
          threadId, turnId, itemId: approvalItemId,
          grantRoot: a.grantRoot ?? null, reason: a.reason || null,
        });
      } else {
        send(asfx.itemStartedCommandExecution(threadId, turnId, approvalItemId, a.command || 'true'));
        request = asfx.commandApprovalRequest(reqId, {
          threadId, turnId, itemId: approvalItemId,
          command: a.command || 'true', reason: a.reason || null,
        });
      }
      // Blocking, like the real server: the turn does not progress until the
      // client answers this server-to-client request (section 5).
      const decision = await new Promise(resolve => {
        pendingServerRequests.set(reqId, resolve);
        send(request);
      });
      log({ approvalDecision: decision, requestId: reqId });
      if (t.finished) return;
      // Object decisions (execpolicy/network amendments) count as accepts.
      const key = (decision === 'decline') ? 'decline'
        : (decision === 'cancel') ? 'cancel'
        : 'accept';
      if (key === 'cancel') { finishTurn(t, 'interrupted'); return; }
      const after = (a.afterDecision || {})[key] || {};
      if (after.text != null) text = after.text;
      // A model reads a line steered into its turn before it carries on. A
      // rule can wait for one after a decline (bounded) and answer with
      // `afterDecision.steered` when it came, as a model told to stop would.
      // `awaitSteerOnAcceptMs` waits the same way after an accept, so a line
      // steered into an approved turn lands while the turn is still running.
      const waitMs = key === 'decline' ? a.awaitSteerMs : (key === 'accept' ? a.awaitSteerOnAcceptMs : 0);
      if (waitMs > 0) {
        const until = Date.now() + waitMs;
        while (!t.steered && !t.finished && Date.now() < until) await tick(5);
        if (t.finished) return;
        const steered = (a.afterDecision || {}).steered;
        if (key === 'decline' && t.steered && steered && steered.text != null) text = steered.text;
      }
    }

    if (rule.awaitHelpers) {
      const until = Date.now() + 30000;
      while (t.helperTurns.some(h => !h.finished) && !t.finished && Date.now() < until) await tick(5);
      if (t.finished) return;
    }

    if (rule.error) {
      send(asfx.errorNotification(threadId, turnId, rule.error));
    }
    if (rule.error && !rule.error.thenContinue) {
      finishTurn(t, 'failed', {
        message: rule.error.message || 'stub turn error',
        codexErrorInfo: rule.error.codexErrorInfo || null,
      });
      return;
    }

    if (rule.noise) {
      // Format-drift resilience (mirrors the exec stub): a malformed line,
      // an unknown notification, and a delta for an item that never started
      // must all be skipped by the client without breaking the turn.
      writeOut('{not json at all\n');
      send({ method: 'totally/unknown', params: { threadId } });
      send(asfx.agentMessageDelta(threadId, turnId, 'item_ghost', 'GHOST'));
    }

    // CONTEXT COMPACTION, in the order codex-cli 0.156.1 sends it
    // (test/fixtures/compaction/codex-auto-compact.jsonl): a contextCompaction
    // item started and completed BETWEEN agentMessage items, never inside one.
    const cmp = rule.compaction || null;
    const sendCompaction = async () => {
      if (cmp.malformed) {
        send({ method: 'item/started', params: { item: { type: 'contextCompaction' }, threadId, turnId } });
        send({ method: 'item/completed', params: { item: { type: 'contextCompaction', id: 7 }, threadId, turnId } });
        // An item with its id but no turn named.
        send({ method: 'item/started', params: { item: { type: 'contextCompaction', id: `cmp_${shortId}_unrouted` }, threadId } });
        send({ method: 'item/completed', params: { item: { type: 'contextCompaction', id: `cmp_${shortId}_unrouted` }, threadId } });
        send({ method: 'thread/compacted', params: { threadId } });
        send({ method: 'thread/compacted', params: { threadId, turnId: 'turn-of-another-thread' } });
        send({ method: 'thread/compacted' });
        return;
      }
      for (let i = 0; i < (cmp.count || 1); i++) {
        const itemId = `cmp_${shortId}_${i}`;
        if (cmp.item !== false) send(asfx.itemStartedContextCompaction(threadId, turnId, itemId));
        await tick();
        if (cmp.finish === false) continue;
        if (cmp.item !== false) send(asfx.itemCompletedContextCompaction(threadId, turnId, itemId));
        if (cmp.duplicate) send(asfx.itemCompletedContextCompaction(threadId, turnId, itemId));
        const notices = cmp.notice === true ? 1 : (cmp.notice || 0);
        for (let n = 0; n < notices; n++) send(asfx.threadCompacted(threadId, turnId));
      }
    };
    if (cmp && !(cmp.afterDeltas > 0)) await sendCompaction();
    if (t.finished) return;

    let agentItemId = `msg_${shortId}`;
    let splitAt = 0;
    send(asfx.itemStartedAgentMessage(threadId, turnId, agentItemId));
    let streamed = 0;
    for (const d of rule.deltas || []) {
      await tick();
      await zombieGate();
      if (t.finished) return;
      send(asfx.agentMessageDelta(threadId, turnId, agentItemId, d));
      streamed += 1;
      if (cmp && streamed === cmp.afterDeltas) {
        send(asfx.itemCompletedAgentMessage(threadId, turnId, agentItemId, rule.deltas.slice(0, streamed).join('')));
        await sendCompaction();
        if (t.finished) return;
        splitAt = streamed;
        agentItemId = `msg_${shortId}_after`;
        send(asfx.itemStartedAgentMessage(threadId, turnId, agentItemId));
      }
      // HOLD THE TURN OPEN UNTIL THE INTERRUPT LANDS, for a rule that asks.
      //
      // Without this a scripted turn is alive for about four milliseconds
      // after its first delta: two deltas at the 2ms default tick, then it
      // completes. A test that must interrupt inside that window is not
      // testing an interrupt, it is testing how busy the machine is, and the
      // stub's zombie path is guarded on the turn still running so a late
      // interrupt silently does nothing and the turn reports 'completed'.
      //
      // The cap exists so a test that never interrupts still ends, and is
      // long enough that reaching it means the test is wrong rather than
      // slow.
      if (rule.holdForInterrupt && streamed === 1) {
        const until = Date.now() + 30000;
        while (!t.interrupted && !t.finished && Date.now() < until) await tick(5);
      }
    }

    if (rule.crashMidTurn) process.exit(1);
    if (rule.hangAfterDeltas) return; // only turn/interrupt completes it now

    await tick();
    await zombieGate();
    if (t.finished) return;
    const finalText = (splitAt ? '' : text) || (rule.deltas || []).slice(splitAt).join('');
    send(asfx.itemCompletedAgentMessage(threadId, turnId, agentItemId, finalText));
    send(asfx.tokenUsageUpdated(threadId, turnId, rule.usage || {}));
    send(asfx.accountRateLimitsUpdated());
    finishTurn(t, 'completed');
  }

  function handleMessage(msg) {
    // A message with an id but no method is the client answering one of OUR
    // server-to-client requests (an approval decision).
    if (msg.method === undefined && msg.id !== undefined) {
      log({ serverRequestResponse: msg.id, result: msg.result ?? null, error: msg.error ?? null });
      const resolve = pendingServerRequests.get(msg.id);
      if (resolve) {
        pendingServerRequests.delete(msg.id);
        resolve(msg.result ? msg.result.decision : 'decline');
      }
      return;
    }

    const { id, method, params } = msg;
    const cfg = loadConfig();
    // What the listed paths held when this request arrived, so a test can ask
    // what was on disk at that moment rather than after the turn.
    const observed = Array.isArray(cfg.observePaths) && cfg.observePaths.length
      ? { observed: Object.fromEntries(cfg.observePaths.map(p => [p, pathState(p)])) } : {};
    log({ method, id: id ?? null, params: params ?? null, ...observed });

    // Request-timeout tests: swallow configured methods entirely.
    if (id !== undefined && Array.isArray(cfg.dropMethods) && cfg.dropMethods.includes(method)) return;

    // Overload simulation: the first N requests to a method get -32001.
    if (id !== undefined && cfg.overload && cfg.overload.method === method) {
      const n = overloadCounts.get(method) || 0;
      if (n < (cfg.overload.times || 0)) {
        overloadCounts.set(method, n + 1);
        send(asfx.overloadErrorResponse(id));
        return;
      }
    }

    switch (method) {
      case 'initialize': {
        const version = cfg.version || '0.144.3';
        const ci = (params && params.clientInfo) || { name: 'unknown', version: '0' };
        const answer = () => send(asfx.response(id, asfx.initializeResult(ci.name, ci.version, version)));
        if (!cfg.initializeUntilFile) { answer(); return; }
        (async () => {
          while (!fs.existsSync(cfg.initializeUntilFile)) await tick(20);
          answer();
        })();
        return;
      }
      case 'initialized': {
        initializedDone = true;
        // The real server pushes unsolicited notifications right after the
        // handshake (RESEARCH.md section 2); clients must ignore them.
        send(asfx.remoteControlStatusChanged());
        return;
      }
    }

    // Like the real server: nothing but initialize works pre-handshake.
    if (!initializedDone && id !== undefined) {
      send(asfx.errorResponse(id, -32600, 'not initialized'));
      return;
    }

    switch (method) {
      case 'thread/start': {
        const threadId = crypto.randomUUID();
        send(asfx.response(id, asfx.threadStartResult(threadId, params || {})));
        send(asfx.threadStartedNotification(threadId, params || {}));
        return;
      }
      case 'thread/resume': {
        const threadId = params && params.threadId;
        // `resumeUntilFile` holds the answer, whichever it will be, until that
        // file exists, so a test can change the workspace while the resume is
        // still undecided. The request is logged on arrival, as always.
        const answer = () => {
          // TRANSIENT IS ANSWERED BEFORE PERMANENT, so the two knobs COMPOSE
          // rather than one hiding the other.
          //
          // Permanent used to be answered first, which made
          // `{ resumeTransientFails: 1, resumeFails: true }` mean simply
          // "permanent" and left the runtime's transient-turned-permanent
          // recovery with no way to be driven at all. That branch was reached
          // only by accident in some environments, so the coverage floor over
          // codex-glue encoded an accident and failed on a machine where the
          // accident did not happen. Ordered this way, the same pair reads as
          // what it looks like: fail transiently N times, then permanently.
          //
          // Transient read-race simulation (Windows Finding 6 Mode 1): an
          // interrupted thread's rollout file can still be empty when the
          // resume arrives (codex flushes it moments later). Wording captured
          // live on Windows 11 / codex-cli 0.144.4; NOT -32600, which is the
          // permanent no-rollout class. Per-thread counter so the (N+1)th
          // resume of the same thread succeeds, like the real flush.
          if (cfg.resumeTransientFails) {
            const n = resumeFailCounts.get(threadId) || 0;
            if (n < cfg.resumeTransientFails) {
              resumeFailCounts.set(threadId, n + 1);
              send(asfx.errorResponse(id, -32603,
                `failed to read thread: thread-store internal error: failed to read session metadata /home/u/.codex/sessions/2026/07/16/rollout-2026-07-16T10-00-00-${threadId}.jsonl: rollout at /home/u/.codex/sessions/2026/07/16/rollout-2026-07-16T10-00-00-${threadId}.jsonl is empty`));
              return;
            }
          }
          // Session-expiry simulation ("resumeFails": true in the appServer
          // config): the real CLI answers thread/resume for a valid-shaped but
          // unknown id with -32600 "no rollout found for thread id ..."
          // (verified live against codex-cli 0.144.3). Config is re-read per
          // message, so tests can fail one turn's resume and let the next pass.
          if (cfg.resumeFails) {
            send(asfx.errorResponse(id, -32600, `no rollout found for thread id ${threadId}`));
            return;
          }
          send(asfx.response(id, asfx.threadStartResult(threadId, params || {})));
          return;
        };
        if (!cfg.resumeUntilFile) { answer(); return; }
        (async () => {
          while (!fs.existsSync(cfg.resumeUntilFile)) await tick(20);
          answer();
        })();
        return;
      }
      case 'turn/start': {
        const threadId = params && params.threadId;
        if (activeTurns.has(threadId)) {
          // One active turn per thread (RESEARCH.md section 9).
          send(asfx.errorResponse(id, -32600, `turn already active on thread ${threadId}`));
          return;
        }
        const turnId = crypto.randomUUID();
        const prompt = ((params && params.input) || [])
          .filter(p => p && p.type === 'text').map(p => p.text).join('\n');
        const rules = cfg.rules || [];
        const rule = rules.find(r => matches(r, prompt))
          || { text: `STUB-APPSERVER-NO-RULE prompt=${prompt.slice(0, 120)}` };
        const t = { turnId, threadId, finished: false };
        activeTurns.set(threadId, t);
        send(asfx.response(id, asfx.turnStartResult(turnId)));
        runTurn(t, prompt, rule).catch(() => {});
        return;
      }
      case 'turn/steer': {
        // An older Codex has no turn/steer: a scenario can say so.
        if (cfg.noSteer) { send(asfx.unknownMethodError(id, method)); return; }
        const t = activeTurns.get(params && params.threadId);
        if (!t || t.finished || params.expectedTurnId !== t.turnId) {
          send(asfx.errorResponse(id, -32600, 'no active turn to steer'));
          return;
        }
        t.steered = ((params && params.input) || []).filter(p => p && p.type === 'text').map(p => p.text).join('\n');
        send(asfx.response(id, { turnId: t.turnId }));
        return;
      }
      case 'turn/interrupt': {
        const t = activeTurns.get(params && params.threadId);
        // A helper's turn can refuse the interrupt (answered with an error) or
        // lose it (never answered); either way the helper carries on.
        if (t && t.helper && (t.helper.interruptFails || t.helper.dropInterrupt)) {
          if (t.helper.interruptFails) send(asfx.errorResponse(id, -32600, 'turn cannot be interrupted'));
          return;
        }
        // Zombie-interrupt simulation (Windows Finding 7, codex-cli 0.144.4
        // on Windows ARM): the interrupt is ACCEPTED with an empty response,
        // but NO turn/completed follows and the turn keeps running in the
        // background. The server-side slot frees (a follow-up turn/start on
        // the same thread succeeds); the zombie's remaining output arrives
        // later, after its scripted resume delay. A retried interrupt for
        // the already-evicted turn gets the same benign empty response.
        // Recorded before any simulation branches, so a turn parked by
        // holdForInterrupt is released by ANY interrupt rather than only by
        // the one shape this config happens to be reproducing.
        if (t) t.interrupted = true;
        if (cfg.zombieInterrupt) {
          send(asfx.response(id, {}));
          if (t && !t.finished && (!params.turnId || params.turnId === t.turnId)) {
            activeTurns.delete(t.threadId);
            t.zombieResumeAt = Date.now() + ((cfg.zombieInterrupt.resumeDelayMs | 0) || 0);
          }
          return;
        }
        // Lost-stream simulation (Windows Finding 6 Mode 2): the interrupt
        // lands server-side (the turn really ends and the slot frees there),
        // but neither the interrupt RESPONSE nor the follow-up
        // turn/completed reaches the client, exactly the shape the VM's
        // periodic network stream disconnects produced. The client must not
        // hold its active-turn slot forever.
        if (cfg.dropInterrupt) {
          if (t && !t.finished && (!params.turnId || params.turnId === t.turnId)) {
            t.finished = true;
            activeTurns.delete(t.threadId);
          }
          return;
        }
        send(asfx.response(id, {}));
        if (t && !t.finished && (!params.turnId || params.turnId === t.turnId)) {
          finishTurn(t, 'interrupted');
        }
        return;
      }
      default:
        if (id !== undefined) send(asfx.unknownMethodError(id, method));
        // Unknown notifications are ignored, like the real server.
    }
  }

  process.stdin.setEncoding('utf-8');
  let buf = '';
  process.stdin.on('data', chunk => {
    buf += chunk;
    let i;
    while ((i = buf.indexOf('\n')) >= 0) {
      const line = buf.slice(0, i);
      buf = buf.slice(i + 1);
      if (!line.trim()) continue;
      let msg;
      try { msg = JSON.parse(line); } catch (e) { log({ badLine: line.slice(0, 200) }); continue; }
      if (!msg || typeof msg !== 'object') continue;
      handleMessage(msg);
    }
  });
  // The real server exits cleanly on stdin EOF (RESEARCH.md, shutdown notes).
  // With outliveStdin it is one that does not, as a server stuck in a turn may
  // not, so only a signal ends it.
  process.stdin.on('end', () => {
    if (!loadConfig().outliveStdin) process.exit(0);
    log({ event: 'stdin-closed' });
    process.stdout.on('error', () => {});
    setInterval(() => {}, 1 << 30);
  });
}
