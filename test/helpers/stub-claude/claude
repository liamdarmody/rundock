#!/usr/bin/env node
'use strict';
// Stub `claude` binary for the Rundock test suite.
//
// Honors the exact invocation shape server.js uses:
//   claude --model X [--agent name] [--resume sid] [--print]
//          --output-format stream-json --input-format stream-json ...
// and speaks scripted stream-json envelopes over stdout, reading stream-json
// user messages from stdin. No network, no API, no real Claude binary.
//
// Injection: the test harness prepends this directory to PATH, so server.js's
// existing resolveClaudeBin() (`which claude`) finds this stub with zero
// production changes.
//
// Scripting: the stub reads `stub-scenario.json` from its cwd (server.js
// spawns claude with cwd = WORKSPACE, so scenarios live in the test
// workspace). Scenario format:
//   { "rules": [ { "match": { "agent": "chief-of-staff",
//                             "promptIncludes": "hooks" | ["a","b"],
//                             "promptExcludes": "x",
//                             "resume": true },  // gate on --resume presence
//                  "delayMs": 0,
//                  "singleChunk": false,
//                  "isError": false,
//                  "crash": 1,   // exit with this code WITHOUT emitting a result
//                                // envelope: simulates an abnormal mid-turn death
//                                // (CLI crash / OOM / auth expiry). No `turn` runs.
//                  "stderr": "...",     // written to stderr: before a crash exit,
//                                       // or alongside an ordinary turn
//                  "crashTail": "...",  // final stdout fragment, no newline,
//                                       // left in the server's line buffer
//                  "turn": [ { "text": "..." },
//                            { "agentTool": { "subagent_type": "wren", "prompt": "..." } },
//                            { "tool": { "name": "Read", "input": {...} } },
//                            { "raw": { ...literal envelope... } } ],
//                  "webFetch": "http://..." } ],   // a real HTTP request from this
//                                                  // process first, reported as a
//                                                  // WebFetch call and its status
//     "deadSessions": ["id", ...],   // a --resume of any of these is refused at
//                                    // startup exactly as Claude Code refuses an
//                                    // id it has no session file for
//     "refusalExitMs": 0,            // how long the refused process lingers
//     "refusalSplitAt": 0,           // write the refusal line in pieces
//     "refusalPreamble": "...",      // stderr written just before the refusal
//     "refusalAfterInit": false,     // send the init envelope before refusing
//     "loadAgentFiles": false }      // read agent files as Claude Code does, and
//                                    // refuse an --agent no file loads for
//                                    // (see AGENT_NOT_LOADED below)
// A crash rule may give "stderrChunks": [...] to write its stderr in pieces.
// A crash rule may give "beforeSession": true to fail at startup, before the
// session's transcript exists, as an expired login does.
// Any rule may give "exitAfterTurn": n to exit with code n after its turn.
// A rule may give "shell": ["rm a.md", "mv b.md c.md"], commands the run
// gives its shell tool. Each is put to the PreToolUse hooks the --settings
// file names first, as Claude Code does, and really runs unless a hook or the
// deny rules refuse it (see THE TOOL FLAGS below). `writes` entries are held
// to the same deny rules, and a `writes` entry may give "content", the exact
// text the write carries.
// Any rule may give "hooks": [{ "event", "tool", "input", "error", "extra" }] to
// run Rundock's real permission hook for each call, in order, before its turn:
// see runHookCalls below.
// First matching rule wins; rules are re-read from disk on every message so
// tests can rewrite the script mid-scenario. The stub also appends every
// invocation to `stub-invocations.jsonl` (cwd) for spawn-arg assertions.
//
// Envelope shapes come from test/fixtures/stream-json.js: the SAME fixtures
// the unit tests pin against wireProcessHandlers.

const fs = require('fs');
const path = require('path');
const readline = require('readline');
const fx = require(path.join(__dirname, '..', '..', 'fixtures', 'stream-json.js'));

const argv = process.argv.slice(2);

// Version probe: answer immediately without touching stdin or the scenario,
// so runtime detection never hangs on the stub. No invocation is logged for
// version probes (they are not conversation spawns).
//
// The version is the Claude Code the stub's behaviour was last measured
// against (test/fixtures/claude-cli-*.json), so it is one Rundock will start:
// spawnClaude starts nothing older than the flags it passes. `-stub` is how a
// test tells it from a real install. A test that needs another version sets
// STUB_CLAUDE_VERSION, read on every probe.
if (argv.includes('--version')) {
  process.stdout.write(`${process.env.STUB_CLAUDE_VERSION || '2.1.318-stub'} (Claude Code)\n`);
  process.exit(0);
}

// The connection check (`--print test --output-format text`, the turn the
// reconnect card's "I've reconnected" runs): answer at once, without a
// scenario or a log line. A test signs the stub out with STUB_CLAUDE_SIGNED_OUT,
// or fails the turn for a reason that is not the sign-in with
// STUB_CLAUDE_CHECK_FAILS.
if (argv.includes('--print') && argv[argv.indexOf('--output-format') + 1] === 'text') {
  if (process.env.STUB_CLAUDE_SIGNED_OUT === '1') {
    process.stderr.write('Invalid API key. Please run /login\n');
    process.exit(1);
  }
  if (process.env.STUB_CLAUDE_CHECK_FAILS === '1') {
    process.stderr.write('API Error: Connection error.\n');
    process.exit(1);
  }
  process.stdout.write('ok\n');
  process.exit(0);
}

function argValue(flag) {
  const i = argv.indexOf(flag);
  return i >= 0 ? argv[i + 1] : null;
}
const AGENT = argValue('--agent');
const MODEL = argValue('--model');
const RESUME = argValue('--resume');
const PRINT = argv.includes('--print');
const SCENARIO_FILE = path.join(process.cwd(), 'stub-scenario.json');
const LOG_FILE = path.join(process.cwd(), 'stub-invocations.jsonl');
// Prompt log lives in a SEPARATE file from the invocation log on purpose:
// several tests assert exact counts and indices over readInvocations()
// (e.g. delegation.test.js "no second spawn" expects length 0, chat-basic
// reads invocations[0]). Mixing per-message records into that file would
// silently corrupt those assertions. Parity note: this is the Claude-side
// equivalent of codexTurnPrompts(), which the codex stub has had all along.
const PROMPT_LOG_FILE = path.join(process.cwd(), 'stub-prompts.jsonl');

// Record the invocation for spawn-arg assertions.
try {
  fs.appendFileSync(LOG_FILE, JSON.stringify({
    pid: process.pid, ts: Date.now(), agent: AGENT, model: MODEL,
    resume: RESUME, print: PRINT, argv,
    env: {
      RUNDOCK: process.env.RUNDOCK || null,
      RUNDOCK_CONVO_ID: process.env.RUNDOCK_CONVO_ID || null,
      RUNDOCK_CODE_MODE: process.env.RUNDOCK_CODE_MODE || null,
      RUNDOCK_PORT: process.env.RUNDOCK_PORT || null,
      // The hook token this agent was started with, so a test can tell two
      // runs' tokens apart, and use one after its run has ended.
      RUNDOCK_HOOK_TOKEN: process.env.RUNDOCK_HOOK_TOKEN || null,
    },
  }) + '\n');
} catch (e) { /* logging is best-effort */ }

// THE TOOL FLAGS, READ AS CLAUDE CODE READS THEM.
//
// Both are variadic in the real CLI (`--allowed-tools <tools...>` and
// `--disallowed-tools <tools...>` in its help): each takes every argument
// after it up to the next one starting with a dash. So a list placed where
// only the prompt follows it takes the prompt as one more tool, and a --print
// run is left with no input.
const VARIADIC_FLAGS = new Set(['--allowed-tools', '--disallowed-tools']);
function variadicValues(flag) {
  const out = [];
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] !== flag) continue;
    for (let j = i + 1; j < argv.length && !argv[j].startsWith('-'); j++) out.push(argv[j]);
  }
  return out;
}

// The deny rules, and what they refuse. Measured against a real run in the
// routine's spawn shape (--print --dangerously-skip-permissions, driven by a
// stand-in for the API), not read from documentation:
//   - a path rule matches only under Edit(...), and an Edit(path) rule covers
//     every tool that writes a file. Claude Code's own rule check says a
//     Write(path) rule never matches, and a run given only Write(*.py) wrote
//     tool.py;
//   - a bare tool name turns that tool off;
//   - a shell `rm` or `mv` that names a path an Edit(path) rule covers is
//     refused, even when the permission hook answered allow, in a routine's
//     spawn shape and in a conversation's;
//   - a write a path rule refuses is never put to the hook; a shell command is
//     put to it first, and refused afterwards all the same.
// The measurement is committed, with the tool that makes it:
// test/fixtures/claude-cli-notes-mode.json, written by
// test/tools/claude-cli-notes-mode-probe.js, and
// test/unit/stub-claude-matches-cli.test.js holds this stub to it. The
// refusal messages below are the CLI's own words from that record.
// Only the shapes Rundock writes are modelled: a bare name, and `*.ext`, which
// has no slash and so matches a file of that name at any depth, as gitignore
// patterns do. Any other shape stops the run with a line on stderr rather than
// quietly matching nothing, so no test can pass on a rule the stub ignored.
const FILE_WRITING_TOOLS = new Set(['Write', 'Edit', 'MultiEdit', 'NotebookEdit']);
function splitRules(values) {
  // "Comma or space-separated", and a rule's own parentheses may hold either.
  const out = [];
  for (const value of values) {
    let depth = 0;
    let cur = '';
    for (const ch of value) {
      if (ch === '(') depth++;
      if (ch === ')') depth--;
      if (depth === 0 && (ch === ',' || /\s/.test(ch))) {
        if (cur) out.push(cur);
        cur = '';
        continue;
      }
      cur += ch;
    }
    if (cur) out.push(cur);
  }
  return out;
}
function notModelled(what) {
  // Synchronous, so the line is out before the exit.
  fs.writeSync(2, `stub claude: ${what} is not modelled\n`);
  process.exit(2);
}
const DENY_RULES = splitRules(variadicValues('--disallowed-tools')).map((text) => {
  const m = /^([A-Za-z]+)(?:\((.*)\))?$/.exec(text);
  const ext = m && m[2] !== undefined ? /^\*(\.[^/*?[\]]+)$/.exec(m[2]) : null;
  if (!m || (m[2] !== undefined && !ext)) notModelled(`the deny rule ${text}`);
  return { tool: m[1], ext: ext ? ext[1] : null };
});
function deniedTool(tool) {
  return DENY_RULES.some(r => r.ext === null && r.tool === tool);
}
function deniedPath(file) {
  return DENY_RULES.some(r => r.tool === 'Edit' && r.ext !== null && path.basename(file).endsWith(r.ext));
}
function disabledTool(tool) {
  return `<tool_use_error>Error: No such tool available: ${tool}. ${tool} is disabled for this session, in subagents as well as here.</tool_use_error>`;
}
const REFUSED_PATH = '<tool_use_error>File is in a directory that is denied by your permission settings.</tool_use_error>';
// What the CLI says back to a write the deny rules refuse, or null.
function writeRefusal(tool, file) {
  if (deniedTool(tool)) return disabledTool(tool);
  if (FILE_WRITING_TOOLS.has(tool) && deniedPath(file)) return REFUSED_PATH;
  return null;
}
function deniedWrite(tool, file) {
  return writeRefusal(tool, file) !== null;
}

// THE PreToolUse HOOKS, run as Claude Code runs them: each command hook whose
// matcher matches the tool, through the shell, with the call as JSON on stdin
// and this process's environment (which is how Rundock's hook finds its
// server). An answer of deny refuses the call, in the CLI's words for it.
// Allow, or no answer, leaves it to the deny rules, which still refuse what
// they cover.
// Only shell entries are put to the hooks here: a file-tool write never is,
// which matches the CLI for every write a path rule refuses (it never asks the
// hook about one) and leaves the hook unasked for the writes it allows. An
// answer of ask, and a hook exiting 2, are not modelled.
const SETTINGS = (() => {
  const value = argValue('--settings');
  if (!value) return {};
  try { return JSON.parse(value.trim().startsWith('{') ? value : fs.readFileSync(value, 'utf8')); } catch (e) { return {}; }
})();
function preToolUseHooks(tool) {
  const entries = (SETTINGS.hooks && Array.isArray(SETTINGS.hooks.PreToolUse)) ? SETTINGS.hooks.PreToolUse : [];
  return entries.filter((e) => {
    const m = e && typeof e.matcher === 'string' ? e.matcher : '';
    if (!m || m === '*') return true;
    try { return new RegExp(`^(?:${m})$`).test(tool); } catch (err) { return m === tool; }
  }).flatMap(e => (Array.isArray(e.hooks) ? e.hooks : [])).filter(h => h && h.type === 'command' && h.command);
}
function askHooks(tool, input) {
  const { spawnSync } = require('child_process');
  for (const hook of preToolUseHooks(tool)) {
    if (hook.shell && hook.shell !== 'bash') notModelled(`a hook run through ${hook.shell}`);
    const r = spawnSync('/bin/sh', ['-c', hook.command], {
      cwd: process.cwd(), env: process.env, encoding: 'utf8',
      timeout: (Number(hook.timeout) || 60) * 1000,
      input: JSON.stringify({
        session_id: FIXED_SESSION || RESUME || '', cwd: process.cwd(), permission_mode: argValue('--permission-mode') || 'default',
        hook_event_name: 'PreToolUse', tool_name: tool, tool_input: input,
      }),
    });
    if (r.status === 2) notModelled('a hook exiting 2');
    let out = {};
    try { out = JSON.parse(r.stdout || '{}'); } catch (e) { /* no answer */ }
    const said = out && out.hookSpecificOutput ? out.hookSpecificOutput : {};
    if (said.permissionDecision === 'deny') return `PreToolUse:${tool} hook error: ${said.permissionDecisionReason || ''}`;
    if (said.permissionDecision === 'ask') notModelled('a hook answering ask');
  }
  return null;
}

// A rule's `shell` entries: `rm` and `mv` only, the two whose refusal was
// measured, with plain space-separated paths. Each is put to the hooks, then
// to the deny rules, and really runs against the disk unless one of them
// refuses it, in which case nothing is touched. Returns what the CLI would
// have said back, which the transcript records.
function runShell(command) {
  const [verb, ...words] = String(command).trim().split(/\s+/);
  if (verb !== 'rm' && verb !== 'mv') notModelled(`the shell command ${verb}`);
  const paths = words.filter(w => !w.startsWith('-')).map(w => path.resolve(process.cwd(), w));
  if (deniedTool('Bash')) return { command, refusal: disabledTool('Bash') };
  const hookRefusal = askHooks('Bash', { command, description: 'shell' });
  if (hookRefusal !== null) return { command, refusal: hookRefusal };
  if (paths.some(deniedPath)) return { command, refusal: `Permission to use Bash with command ${command} has been denied.` };
  try {
    if (verb === 'rm') for (const p of paths) fs.rmSync(p, { force: true });
    else fs.renameSync(paths[0], paths[1]);
  } catch (e) { return { command, refusal: null, failed: e.message }; }
  return { command, refusal: null };
}

// The server SIGKILLs stubs mid-stream by design (interception, auto-return).
// Never crash on a broken pipe.
process.stdout.on('error', () => {});
process.stderr.on('error', () => {});
// Counted where the bytes are handed over, so a test that cares how much a run
// emitted reads a measurement instead of trusting the size of the fixture it
// wrote. Only what write() accepted is counted: a stub killed mid-write did
// not emit that chunk. Both descriptors are counted, because both can be piped
// and an unread pipe hangs a child whichever one it is.
let WROTE = 0;
let WROTE_ERR = 0;
function writeOut(s) {
  try { process.stdout.write(s); WROTE += Buffer.byteLength(s); } catch (e) { /* killed mid-write */ }
}
function writeErr(s) {
  try { process.stderr.write(s); WROTE_ERR += Buffer.byteLength(s); } catch (e) { /* killed mid-write */ }
}

// A --print run ends when its output has actually left the process, not when
// the last write() call returns, and that is true of BOTH descriptors.
//
// process.exit() throws away whatever the output streams still have queued,
// and on a pipe that is everything the kernel buffer would not take: 500 KB
// written and exited on the spot closes in 32 ms with most of it discarded.
// A stub that exits that way cannot reproduce the commonest way a subprocess
// hangs, which is why the routine deadlock was invisible to every test here.
//
// AN ASSUMPTION, AND IT SHOULD BE READ AS ONE. Nothing in this repository
// establishes what the real `claude` binary does with output it has queued
// when it finishes: whether it waits for the reader or exits regardless. This
// stub models the one that waits, because that is the conservative choice for
// a hazard test (a stub that exits regardless cannot show a hang that a real
// waiting binary would suffer), and because a process whose output survives is
// what every user of a CLI expects. The original hang was measured
// synthetically, on a throwaway parent and child; there is no field report of
// it anywhere in this repository. Both halves of that are worth knowing.
//
// The output log is written from the same callback, so the byte counts belong
// to output that really left rather than to output that was merely queued.
const OUTPUT_LOG = path.join(process.cwd(), 'stub-output.jsonl');
function exitWhenWritten(code) {
  let pending = 2;
  const done = () => {
    if (--pending > 0) return;
    try {
      fs.appendFileSync(OUTPUT_LOG, JSON.stringify({
        agent: AGENT, pid: process.pid, stdoutBytes: WROTE, stderrBytes: WROTE_ERR, ts: Date.now(),
      }) + '\n');
    } catch (e) { /* logging is best-effort */ }
    process.exit(code);
  };
  process.stdout.write('', done);
  process.stderr.write('', done);
}

// A run that was told which session to be is that session, exactly as the
// real binary is: --session-id fixes the id, and the transcript below is
// named for it. Only the routine spawn passes it today.
const FIXED_SESSION = argValue('--session-id');
const SESSION_ID = FIXED_SESSION || RESUME || `stub-${AGENT || 'default'}-${process.pid}`;
let initSent = false;

function loadRules() {
  try {
    return JSON.parse(fs.readFileSync(SCENARIO_FILE, 'utf-8')).rules || [];
  } catch (e) {
    return [];
  }
}

// A SESSION CLAUDE CODE NO LONGER HAS, refused the way the real binary refuses
// it. Asked to --resume an id whose session file has gone (pruned, or never
// written on this machine), the CLI writes one line to stderr and exits 1 at
// startup: before it reads any input, and before any init envelope. A scenario
// names such ids in its top-level `deadSessions`. Read once, at spawn, which is
// when the real binary looks, so a test brings a session back by rewriting the
// list before the next spawn. `refusalExitMs` holds the process open that long
// after the line is written, which is the moment a person can still stop it.
function scenarioTop() {
  try {
    return JSON.parse(fs.readFileSync(SCENARIO_FILE, 'utf-8')) || {};
  } catch (e) {
    return {};
  }
}
const TOP = scenarioTop();
const REFUSED_RESUME = RESUME != null && Array.isArray(TOP.deadSessions) && TOP.deadSessions.includes(RESUME);
if (REFUSED_RESUME) {
  // `refusalSplitAt` writes the line in pieces a moment apart (cut at that
  // character, then the newline on its own), the way a pipe may deliver it.
  // `refusalPreamble` is stderr written on its own just before the refusal,
  // such as Claude Code's warning that it read no stdin.
  const line = `No conversation found with session ID: ${RESUME}`;
  const cut = Number(TOP.refusalSplitAt) || 0;
  const pieces = [
    ...(TOP.refusalPreamble ? [String(TOP.refusalPreamble)] : []),
    ...(cut > 0 ? [line.slice(0, cut), line.slice(cut), '\n'] : [`${line}\n`]),
  ];
  const wait = Number(TOP.refusalExitMs) || 0;
  const finish = () => (wait > 0 ? setTimeout(() => exitWhenWritten(1), wait) : exitWhenWritten(1));
  // `refusalAfterInit` sends the init envelope for the refused id first. The
  // real binary is not known to, but nothing guarantees the order either.
  if (TOP.refusalAfterInit) { writeOut(fx.toLines([fx.init(RESUME)])); initSent = true; }
  writePieces(pieces, finish);
}

// AN AGENT FILE CLAUDE CODE CANNOT LOAD, refused the way the real binary
// refuses it. Claude Code drops an agent file it cannot read without a word:
// no `name:`, no `description:`, or frontmatter its YAML reader refuses. A
// --print run started with --agent naming such an agent then writes one line
// to stderr and exits 1, before any session or transcript exists. The
// reading is lib/agents/claude-code-load.js, through
// test/helpers/claude-code-agents.js, and test/unit/claude-cli-agent-load.test.js
// holds it to a record of the real CLI.
//
// OPT IN, with a top-level `loadAgentFiles: true`, because most fixtures here
// were written with no description, and the real binary would drop every one
// of them. Conversation spawns are not modeled: there, Claude Code runs on as
// a plain session and says nothing at all, which is no reply a stub can give.
// Read once, at spawn, which is when the real binary looks, so a test fixes a
// file and the next child loads it.
const AGENT_NOT_LOADED = (() => {
  if (!PRINT || REFUSED_RESUME || AGENT == null || TOP.loadAgentFiles !== true) return false;
  const agents = require(path.join(__dirname, '..', 'claude-code-agents.js'));
  const available = agents.loadableAgentNames(process.cwd());
  if (available.includes(AGENT)) return false;
  // `refusalPreamble`, as for a refused resume: whatever Claude Code printed
  // before it refused, which puts the refusal last.
  if (TOP.refusalPreamble) writeErr(String(TOP.refusalPreamble));
  writeErr(`${agents.agentNotFoundLine(AGENT, available)}\n`);
  exitWhenWritten(1);
  return true;
})();

// Write stderr in pieces a moment apart, so each reaches the reader as its
// own chunk, then carry on.
function writePieces(pieces, then) {
  let at = 0;
  const next = () => {
    writeErr(String(pieces[at++]));
    if (at < pieces.length) setTimeout(next, 40);
    else then();
  };
  next();
}

function matches(rule, prompt) {
  const m = rule.match || {};
  if (m.agent !== undefined && m.agent !== AGENT) return false;
  // Gate a rule on whether this spawn is a --resume: lets a scenario crash
  // the resumed process while answering its fresh retry normally.
  if (m.resume !== undefined && m.resume !== (RESUME != null)) return false;
  const includes = m.promptIncludes == null ? [] : [].concat(m.promptIncludes);
  for (const s of includes) if (!prompt.includes(s)) return false;
  const excludes = m.promptExcludes == null ? [] : [].concat(m.promptExcludes);
  for (const s of excludes) if (prompt.includes(s)) return false;
  return true;
}

function buildEnvelopes(rule) {
  const events = [];
  if (!initSent) { events.push(fx.init(SESSION_ID)); initSent = true; }
  let fullText = '';
  let toolIndex = 1;
  let hadTool = false;
  for (const block of rule.turn || []) {
    if (block.text != null) {
      events.push(fx.contentBlockStartText());
      const text = block.text;
      const mid = Math.max(1, Math.floor(text.length / 2));
      events.push(fx.textDelta(text.slice(0, mid)));
      if (text.length > 1) events.push(fx.textDelta(text.slice(mid)));
      events.push(fx.contentBlockStop());
      fullText += (fullText ? '\n' : '') + text;
    } else if (block.agentTool) {
      hadTool = true;
      events.push(...fx.toolUseFlow('Agent', block.agentTool, toolIndex++));
    } else if (block.tool) {
      hadTool = true;
      events.push(...fx.toolUseFlow(block.tool.name, block.tool.input || {}, toolIndex++));
    } else if (block.raw) {
      events.push(block.raw);
    }
  }
  // Faithful end-of-message shape: the real stream closes the message with
  // message_delta + message_stop BEFORE any consolidated assistant envelope,
  // and interactive turns may omit the assistant envelope entirely. A rule
  // sets realStream: true to model that omission and pin code paths against
  // the production shape.
  events.push(fx.messageDelta(hadTool ? 'tool_use' : 'end_turn'));
  events.push(fx.messageStop());
  if (!rule.realStream) events.push(fx.assistantMessage(fullText));
  events.push(fx.result({ text: fullText, isError: !!rule.isError, sessionId: SESSION_ID }));
  return events;
}

// THE TRANSCRIPT, which is the half of a run this stub used not to leave
// behind at all. The real binary appends every message and every tool result
// to ~/.claude/projects/<cwd encoded>/<session id>.jsonl as it goes, and that
// file is the only place a run's tool OUTCOMES are recorded. A stub that
// spoke the stream and left no transcript could not reproduce the defect the
// reader exists to prevent: a write that was refused looking exactly like one
// that happened.
//
// The directory rule is the one observed from a real run (every character
// that is not a letter or a digit becomes a dash), written out here rather
// than shared with the reader, which deliberately makes no assumption about
// it and searches by session id instead. If the rule is ever wrong, the
// reader still finds this file and only the stub is wrong, which is the right
// way round.
//
// A rule's `writes` entries REALLY WRITE their files, except the ones whose
// outcome is 'error'. That is what lets a test compare the list a run reports
// against what is actually on disk, instead of against the fixture it asked
// for.
const tfx = require(path.join(__dirname, '..', '..', 'fixtures', 'session-transcript.js'));

function transcriptFile() {
  if (!FIXED_SESSION) return null;
  const dir = path.join(process.env.HOME || '', '.claude', 'projects', process.cwd().replace(/[^a-zA-Z0-9]/g, '-'));
  try {
    fs.mkdirSync(dir, { recursive: true });
    return path.join(dir, `${FIXED_SESSION}.jsonl`);
  } catch (e) { return null; }
}

function putTranscript(rule, lines) {
  if (rule.skipTranscript) return;
  const file = transcriptFile();
  if (!file) return;
  try { fs.writeFileSync(file, lines.join('')); } catch (e) { /* best effort, like every log here */ }
}

// WHAT THE RUN HAS GOT TO, written when it gets there. A real run appends its
// transcript as it goes, so a run still in flight has asked for its tool and
// has no outcome for it yet. Modelled in two steps for exactly that reason: a
// stub that only wrote the finished transcript could not show a run being
// asked what it is doing, and a reader that counted asks as changes would
// pass against it.
function beginTranscript(rule, prompt) {
  putTranscript(rule, [
    tfx.prompt(FIXED_SESSION, String(prompt)),
    ...(rule.writes || []).map(w => tfx.unanswered(FIXED_SESSION, {
      tool: w.tool || 'Write', file: path.resolve(process.cwd(), w.file), outcome: w.outcome || 'create', at: w.at, content: w.content,
    })),
  ]);
}

// The end of the run: the writes REALLY HAPPEN here, except the ones whose
// outcome is 'error', which is what lets a test compare the list a run reports
// against what is actually on disk rather than against the fixture it asked
// for. The file writes are not conditional on a transcript being kept: a run
// whose transcript goes missing still changed the workspace, which is the case
// that separates "changed nothing" from "nobody can say".
function finishTranscript(rule, prompt, shellRan = []) {
  const lines = [tfx.prompt(FIXED_SESSION, String(prompt))];
  for (const ran of shellRan) lines.push(tfx.shellTool(FIXED_SESSION, ran));
  for (const w of rule.writes || []) {
    const file = path.resolve(process.cwd(), w.file);
    // WHETHER THIS WAS A CREATION OR AN OVERWRITE IS DECIDED BY THE DISK, not
    // by the scenario, exactly as the real tool decides it. A scenario that
    // could declare "update" for a file that was not there would let a test
    // assert an edit against a run that created something, which is the field
    // the whole created-versus-edited distinction lives in.
    let outcome = w.outcome === 'error' ? 'error' : null;
    // A write the deny rules refuse never reaches the disk, and its tool call
    // ends in an error carrying the CLI's own words for the refusal.
    const refusal = outcome === 'error' ? null : writeRefusal(w.tool || 'Write', file);
    if (refusal !== null) outcome = 'error';
    if (outcome !== 'error') {
      try {
        outcome = fs.existsSync(file) ? 'update' : 'create';
        fs.mkdirSync(path.dirname(file), { recursive: true });
        fs.writeFileSync(file, w.content != null ? String(w.content) : `${outcome}:${w.file}\n`);
      } catch (e) { /* the transcript still records what was attempted */ }
    }
    lines.push(tfx.completed(FIXED_SESSION, { tool: w.tool || 'Write', file, outcome, at: w.at, content: w.content, refusal }));
  }
  for (const block of rule.turn || []) if (block.text != null) lines.push(tfx.say(FIXED_SESSION, block.text));
  putTranscript(rule, lines);
}

function emitTurn(rule, prompt) {
  const shellRan = (rule.shell || []).map(runShell);
  if (FIXED_SESSION) finishTranscript(rule, prompt, shellRan);
  const events = buildEnvelopes(rule);
  // A run that ends normally can still have written to stderr: warnings,
  // progress, deprecation notices. Modelled because stderr is a pipe like any
  // other and fills like any other, and a scenario that can only reach it by
  // crashing cannot exercise that at all.
  if (rule.stderr) writeErr(String(rule.stderr));
  if (rule.singleChunk) {
    // One write -> one 'data' chunk on the server side (small payloads do not
    // get split by the pipe). Used to pin per-chunk guard behavior.
    writeOut(fx.toLines(events));
  } else {
    for (const e of events) writeOut(JSON.stringify(e) + '\n');
  }
  // `exitAfterTurn: n` ends the process with code n once the turn is out: a
  // run that answered and then failed, which is not a resume that failed.
  if (rule.exitAfterTurn != null) exitWhenWritten(Number(rule.exitAfterTurn));
  else if (PRINT) exitWhenWritten(0);
}

// Model an MCP server. The real `claude` spawns these as its OWN children over
// stdio, so they are grandchildren of the server, which holds no handle on
// them. A rule sets `spawnChild: true` to reproduce that shape. The pid is
// logged so a test can assert whether it survived its parent being killed.
const GRANDCHILD_LOG = path.join(process.cwd(), 'stub-grandchildren.jsonl');
let spawnedGrandchild = false;
function spawnGrandchild() {
  if (spawnedGrandchild) return;
  spawnedGrandchild = true;
  try {
    const { spawn } = require('child_process');
    // Long-lived and signal-quiet, like a stdio MCP server idling on input.
    const kid = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1e9)'], { stdio: 'ignore' });
    kid.unref();
    fs.appendFileSync(GRANDCHILD_LOG, JSON.stringify({
      parentAgent: AGENT, parentPid: process.pid, pid: kid.pid, ts: Date.now(),
    }) + '\n');
  } catch (e) { /* best effort */ }
}

// Record every prompt this stub receives so tests can assert directly on what
// the server sent, instead of asserting by side effect (writing a rule that
// only matches the expected payload, then waiting for its output). The
// side-effect pattern fails as an unrelated 8s timeout with no diff, which is
// why payload assertions were rare enough for the 0.11.2 handback-amnesia bug
// to survive. `matched` lets a test assert no prompt fell through to the
// STUB-NO-RULE fallback.
function logPrompt(content, matched) {
  try {
    fs.appendFileSync(PROMPT_LOG_FILE, JSON.stringify({
      agent: AGENT, sessionId: SESSION_ID, resume: RESUME,
      prompt: String(content), matched, ts: Date.now(),
    }) + '\n');
  } catch (e) { /* logging is best-effort */ }
}

function handleUserMessage(content) {
  const rules = loadRules();
  const matchedRule = rules.find(r => matches(r, content));
  logPrompt(content, !!matchedRule);
  const rule = matchedRule || {
    turn: [{ text: `STUB-NO-RULE agent=${AGENT} prompt=${String(content).slice(0, 120)}` }],
  };
  if (rule.spawnChild) spawnGrandchild();
  // Written before the turn is emitted, and before any delay, so a run held
  // open by a delayed rule has a transcript to be read WHILE it is still
  // going, which is what progress is read from. It holds the tools asked for
  // and no outcomes yet, which is exactly what a run that died halfway leaves
  // behind.
  if (FIXED_SESSION && !rule.beforeSession) beginTranscript(rule, content);
  if (rule.crash != null) {
    // Abnormal death: exit without emitting a result envelope, so the
    // server's close handler runs with no result for this turn.
    // `stderr` models CLI error output (e.g. a failed --resume complaining
    // about the session); `crashTail` writes a final stdout fragment WITHOUT
    // a trailing newline, so it is still sitting in the server's line buffer
    // when the process dies.
    const code = typeof rule.crash === 'number' ? rule.crash : 1;
    const die = () => {
      if (rule.stderr) writeErr(String(rule.stderr));
      if (rule.crashTail) writeOut(String(rule.crashTail));
      // Through the same flushing exit as a normal turn. This was the last
      // bare exit in the file, and it was the only path that wrote to stderr
      // at all, so a full stderr pipe could not be reproduced whatever a test
      // asserted. A crash is still a crash: no result envelope, non-zero code.
      exitWhenWritten(code);
    };
    // `stderrChunks` writes the crash's stderr in those pieces, a moment
    // apart, so a reader sees each as its own chunk.
    if (Array.isArray(rule.stderrChunks)) {
      writePieces(rule.stderrChunks, die);
      return;
    }
    if (rule.delayMs) setTimeout(die, rule.delayMs);
    else die();
    return;
  }
  // `webFetch: <url>`: the model asked for WebFetch, and the tool ran. The
  // real CLI runs its tools in its own process, so this stub does exactly
  // that: a real HTTP request from this process, reported in the stream as a
  // WebFetch tool call and a line naming the status it got back.
  if (rule.webFetch) {
    const url = String(rule.webFetch);
    fetch(url).then((r) => `WEBFETCH-STATUS ${r.status}`, (e) => `WEBFETCH-ERROR ${e.message}`).then((line) => {
      emitTurn({ ...rule, turn: [{ tool: { name: 'WebFetch', input: { url, prompt: 'read it' } } }, { text: line }, ...(rule.turn || [])] }, content);
    });
    return;
  }
  const delay = rule.delayMs || 0;
  const speak = () => {
    if (delay > 0) setTimeout(() => emitTurn(rule, content), delay);
    else emitTurn(rule, content);
  };
  if (Array.isArray(rule.hooks)) runHookCalls(rule.hooks, speak);
  else speak();
}

// THE PERMISSION HOOK, RUN AS THE REAL BINARY RUNS IT: its own process, before
// the tool, with this process's environment (the one Rundock started this
// agent with, conversation and token included) and this session's id. Each
// call waits for the one before it, as an agent's tool calls do. Every answer
// is logged to `stub-hook-answers.jsonl` (cwd), in order, with this process's
// pid to tie it to its invocation, so a test reads what the agent was told
// rather than inferring it. `event` defaults to PreToolUse; `error` is a failed
// call's error, for PostToolUseFailure; `extra` sets fields of the payload, as
// the runtime adds `agent_id` and `agent_type` for a call a subagent makes, or
// a nested `claude` sends a session of its own, and a field set to null is
// left out, as a call that names no session would.
const HOOK_LOG = path.join(process.cwd(), 'stub-hook-answers.jsonl');
const PERMISSION_HOOK = path.join(__dirname, '..', '..', '..', 'scripts', 'permission-hook.js');
function runHookCalls(calls, then) {
  let at = 0;
  const next = () => {
    if (at >= calls.length) { then(); return; }
    const call = calls[at++] || {};
    const event = call.event || 'PreToolUse';
    const input = {
      session_id: SESSION_ID, hook_event_name: event, tool_name: call.tool || 'Bash', tool_input: call.input || {}, cwd: process.cwd(),
      ...(call.error != null ? { error: String(call.error) } : {}),
      ...(call.extra && typeof call.extra === 'object' ? call.extra : {}),
    };
    for (const k of Object.keys(input)) if (input[k] === null) delete input[k];
    let out = '';
    const log = (answer) => {
      try {
        fs.appendFileSync(HOOK_LOG, JSON.stringify({
          pid: process.pid, agent: AGENT, sessionId: SESSION_ID, sentSession: input.session_id || null, subagent: input.agent_id || null, convo: process.env.RUNDOCK_CONVO_ID || null, event, tool: input.tool_name, answer, raw: answer ? undefined : out, ts: Date.now(),
        }) + '\n');
      } catch (e) { /* logging is best-effort */ }
      next();
    };
    let child;
    try {
      child = require('child_process').spawn(process.execPath, [PERMISSION_HOOK], { env: process.env, stdio: ['pipe', 'pipe', 'ignore'] });
    } catch (e) { log(null); return; }
    child.stdout.on('data', (d) => { out += d; });
    child.on('error', () => {});
    child.on('close', () => { let answer = null; try { answer = JSON.parse(out); } catch (e) { /* raw kept */ } log(answer); });
    child.stdin.end(JSON.stringify(input));
  };
  next();
}

// A refused resume never reads its input, exactly as the real binary never
// does: nothing below runs for it, so no prompt is logged and no turn is spoken.
const rl = (REFUSED_RESUME || AGENT_NOT_LOADED) ? null : readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
if (rl) rl.on('line', (line) => {
  if (!line.trim()) return;
  let msg;
  try { msg = JSON.parse(line); } catch (e) { return; }
  if (msg.type === 'user' && msg.message) {
    const content = typeof msg.message.content === 'string'
      ? msg.message.content
      : JSON.stringify(msg.message.content);
    handleUserMessage(content);
  }
});

// Routine spawns use stdio: ['ignore', ...] and pass the prompt as the last
// positional argument with --print. Handle that shape too.
if (PRINT && !REFUSED_RESUME && !AGENT_NOT_LOADED) {
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      // A variadic flag takes everything up to the next flag, the prompt
      // included if nothing else stands between them.
      if (VARIADIC_FLAGS.has(a)) {
        while (i + 1 < argv.length && !argv[i + 1].startsWith('-')) i++;
      // flags with values (skip the value); boolean flags have no value
      } else if (['--model', '--agent', '--resume', '--output-format', '--input-format',
        '--permission-mode',
        '--append-system-prompt', '--settings', '--mcp-config', '--add-dir',
        '--session-id'].includes(a)) i++;
    } else {
      positional.push(a);
    }
  }
  if (positional.length > 0) {
    handleUserMessage(positional[positional.length - 1]);
  } else if (argValue('--input-format') !== 'stream-json') {
    // What the real CLI says, and how it ends, when a --print run has no
    // prompt and nothing on stdin: before any turn, with exit code 1.
    writeErr('Error: Input must be provided either through stdin or as a prompt argument when using --print\n');
    exitWhenWritten(1);
  }
}
