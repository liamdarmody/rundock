{
  "config_version": "1.0.0",
  "project": {
    "name": "Rundock",
    "conventions_file": "CONTRIBUTING.md"
  },
  "roles": {
    "implementer": "implementer",
    "reviewer": "independent reviewer",
    "approver": "release approver"
  },
  "models": {
    "reviewer": "sonnet",
    "implementer": null
  },
  "rounds": {
    "max": 3,
    "stall_rounds": 2
  },
  "dimensions": [
    "criteria",
    "verification",
    "correctness",
    "design"
  ],
  "packet": {
    "exclude_globs": [
      "**/*.plan.md",
      "**/plan/**",
      "**/notes/**",
      "**/scratchpad/**",
      ".independent-review/**"
    ],
    "include_full_files": true,
    "max_bytes": 400000
  },
  "runner": {
    "type": "cli",
    "cli_binary": "claude",
    "command": null,
    "replay_dir": null,
    "timeout_seconds": 900,
    "max_parallel": 2
  },
  "ledger": {
    "path": ".independent-review/"
  },
  "findings": {
    "max_required_change_chars": 600
  }
}
